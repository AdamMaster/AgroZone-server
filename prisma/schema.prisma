generator client {
  provider        = "prisma-client"
  output          = "./generated"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

model User {
  id          String      @id @default(uuid())
  phones      UserPhone[]
  password    String?
  email       String?     @unique
  displayName String?     @map("display_name")
  picture     String?

  type     UserType @default(INDIVIDUAL)
  bio      String?  @db.Text
  location String?

  role UserRole @default(REGULAR)

  isVerified         Boolean @default(false) @map("is_verified")
  isTwoFactorEnabled Boolean @default(false) @map("is_two_factor_enabled")

  method   AuthMethod
  accounts Account[]
  tokens   Token[]

  ads       Ad[]
  favorites Favorite[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model UserPhone {
  id String @id @default(uuid())

  phone String @unique

  isPrimary Boolean @default(false)

  isVerified Boolean @default(false)

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("user_phones")
}

model Account {
  id String @id @default(uuid())

  type              String
  provider          String
  providerAccountId String @map("provider_account_id")

  refreshToken String? @map("refresh_token")
  accessToken  String? @map("access_token")
  expiresAt    Int     @map("expires_at")

  user   User?   @relation(fields: [userId], references: [id])
  userId String? @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Token {
  id String @id @default(uuid())

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String? @map("user_id")

  phone     String?
  email     String?
  token     String
  type      TokenType
  expiresIn DateTime  @map("expires_in")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([token, type])
  @@index([phone, type])
  @@index([userId])
  @@index([token])
  @@map("tokens")
}

model Category {
  id          String  @id @default(uuid())
  name        String
  description String? // 👈 Новое поле

  priceUnits PriceUnit[] @default([ITEM]) @map("price_units")

  slug     String
  path     String[] @default([])
  fullPath String   @unique @map("full_path")

  code String @unique

  iconId String? @map("icon_id")

  parentId String?    @map("parent_id")
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryToCategory")

  level     Int @default(0)
  sortOrder Int @default(0)

  categoryFeatures CategoryFeature[]

  ads Ad[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentId, slug])
  @@index([parentId])
  @@index([slug])
  @@index([fullPath])
  @@index([code])
  @@map("categories")
}

model CategoryFeature {
  id String @id @default(uuid())

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  name        String
  label       String
  description String?

  type FeatureType

  required   Boolean @default(false)
  filterable Boolean @default(true)

  placeholder String?

  unit String?

  options Json?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([categoryId, sortOrder])
  @@map("category_features")
}

enum FeatureType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT
}

model Ad {
  id          String    @id @default(uuid())
  slug        String    @unique @default("")
  title       String
  description String    @db.Text
  price       BigInt?
  unit        PriceUnit @default(ITEM)
  images      String[]
  address     String
  phone       String
  features    Json      @default("{}")
  lat         Float
  lng         Float

  categoryPath String[] @default([]) @map("category_path")
  seoPath      String   @map("seo_path")

  userId String @map("user_id")
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String     @map("category_id")
  category   Category   @relation(fields: [categoryId], references: [id])
  favorites  Favorite[]

  status AdStatus @default(PENDING)

  rejectionReason String?   @map("rejection_reason")
  expiresAt       DateTime? @map("expires_at")
  publishedAt     DateTime? @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([status, expiresAt])
  @@index([userId])
  @@index([categoryId])
  @@index([phone])
  @@map("ads")
}

model Favorite {
  id String @id @default(uuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  adId String @map("ad_id")
  ad   Ad     @relation(fields: [adId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, adId]) // Ограничение: юзер не может добавить одно объявление дважды
  @@index([userId])
  @@index([adId])
  @@map("favorites")
}

enum UserRole {
  REGULAR
  ADMIN
  PREMIUM
}

enum UserType {
  INDIVIDUAL
  BUSINESS
}

enum AuthMethod {
  CREDENTIALS
  GOOGLE
  YANDEX
}

enum TokenType {
  VERIFICATION
  TWO_FACTOR
  PASSWORD_RESET
  EMAIL_CHANGE
  SMS_VERIFICATION
  PHONE_CHANGE
}

enum AdStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
  EXPIRED
}

enum PriceUnit {
  ITEM
  TON
  KG
  LITER
  M3
  BAG
  HEAD
  DOSE
  RUNNING_METER
  HA
  HOUR
}
